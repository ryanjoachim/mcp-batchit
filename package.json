{
  "name": "mcp-batchit",
  "version": "1.1.1",
  "description": "Batch multiple MCP tool calls into a single request—reducing overhead and token usage for AI agents",
  "main": "build/index.js",
  "type": "module",
  "types": "build/index.d.ts",
  "bin": {
    "mcp-batchit": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf build"
  },
  "config": {
    "run-script": {
      "build": "npm run build"
    }
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "batch",
    "operations",
    "ai",
    "llm",
    "agent",
    "filesystem",
    "aggregator"
  ],
  "author": "Ryan Joachim",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanjoachim/mcp-batchit.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0",
    "diff": "^7.0.0",
    "isbinaryfile": "^5.0.4",
    "mammoth": "^1.9.0",
    "minimatch": "^10.0.1",
    "pdf.js-extract": "^0.2.1",
    "remark-gfm": "3.0.1",
    "remark-lint": "9.1.1",
    "remark-parse": "10.0.1",
    "unified": "^10.1.2",
    "vfile": "^5.3.7"
  },
  "devDependencies": {
    "@types/diff": "^7.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "transformIgnorePatterns": [
      "node_modules/(?!(unified|remark-parse|remark-gfm|remark-lint|vfile|unist-util-.*|mdast-.*|micromark.*))"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^unified$": "<rootDir>/node_modules/unified/index.js",
      "^remark-parse$": "<rootDir>/node_modules/remark-parse/index.js",
      "^remark-gfm$": "<rootDir>/node_modules/remark-gfm/index.js"
    },
    "testEnvironment": "node"
  }
}
