{
  "name": "mcp-batchit",
  "version": "1.1.0",
  "description": "Batch multiple MCP tool calls into a single request—reducing overhead and token usage for AI agents",
  "main": "build/index.js",
  "type": "module",
  "types": "build/index.d.ts",
  "bin": {
    "mcp-batchit": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "prettier src --ext .ts"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "batch",
    "operations",
    "ai",
    "llm",
    "agent",
    "filesystem",
    "aggregator"
  ],
  "author": "Ryan Joachim",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanjoachim/mcp-batchit.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0",
    "@types/handlebars": "^4.0.40",
    "@types/sharp": "^0.31.1",
    "diff": "^7.0.0",
    "handlebars": "^4.7.8",
    "isbinaryfile": "^5.0.4",
    "mammoth": "^1.9.0",
    "minimatch": "^10.0.1",
    "pdf-parse": "^1.1.1",
    "remark-gfm": "3.0.1",
    "remark-lint": "9.1.1",
    "remark-parse": "10.0.1",
    "sharp": "^0.33.5",
    "unified": "^10.1.2",
    "uuid": "^11.1.0",
    "vfile": "^5.3.7"
  },
  "devDependencies": {
    "@types/diff": "^7.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.1",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testRegex": "/__tests__/.*\\.test\\.ts$",
    "transformIgnorePatterns": [
      "node_modules/(?!(unified|remark-parse|remark-gfm|remark-lint|vfile|unist-util-.*|mdast-.*|micromark.*))"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
