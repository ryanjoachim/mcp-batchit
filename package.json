{
  "name": "mcp-batchit",
  "version": "1.3.1",
  "description": "MCP filesystem server with batch execution, dependency ordering, and result chaining",
  "main": "build/index.js",
  "type": "module",
  "types": "build/index.d.ts",
  "bin": {
    "mcp-batchit": "./build/index.js"
  },
  "files": [
    "build",
    "!build/**/__tests__",
    "!build/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "build:clean": "npm run clean && npm run build",
    "clean": "rimraf build",
    "check:types": "tsc --noEmit",
    "docs": "typedoc src/index.ts",
    "lint": "prettier --write \"src/**/*.{ts,json,md}\"",
    "lint:check": "prettier --check \"src/**/*.{ts,json,md}\"",
    "test": "jest",
    "validate": "npm run test && npm run lint",
    "start": "node build/index.js"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "batch",
    "operations",
    "ai",
    "llm",
    "agent",
    "filesystem",
    "aggregator"
  ],
  "author": "Ryan Joachim",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanjoachim/mcp-batchit.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "diff": "^7.0.0",
    "handlebars": "^4.7.8",
    "isbinaryfile": "^5.0.4",
    "mammoth": "^1.9.0",
    "minimatch": "^10.0.1",
    "unpdf": "^1.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.1",
    "@types/diff": "^7.0.1",
    "@types/handlebars": "^4.0.40",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.1",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.1",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testRegex": "/__tests__/.*\\.test\\.ts$",
    "transformIgnorePatterns": [
      "node_modules"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
